# Copy this file to .env and fill in your own values.
# Get these from your Supabase project: Settings -> API

VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Same values, without the VITE_ prefix — used by server-side (SSR) code.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Optional — error monitoring. Leave blank to disable Sentry locally.
VITE_SENTRY_DSN=""

# -----------------------------------------------------------------------
# NOT set here — these are Supabase Edge Function secrets, configured via
# the Supabase CLI (`supabase secrets set NAME=value`), not this file:
#
#   SUPABASE_SERVICE_ROLE_KEY   (auto-provided by Supabase at runtime)
#   CAMPAY_PERMANENT_TOKEN
#   CAMPAY_WEBHOOK_SECRET
#   CAMPAY_BASE_URL
#
# See README.md > "Environment variables" for details.
# -----------------------------------------------------------------------
